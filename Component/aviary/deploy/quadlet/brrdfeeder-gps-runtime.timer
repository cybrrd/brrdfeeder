[Unit]
Description=BRRDfeeder GPS runtime transport: hotplug retry and recovery observation
[Timer]
OnBootSec=5s
OnUnitInactiveSec=5s
AccuracySec=1s
Unit=brrdfeeder-gps-runtime.service
[Install]
WantedBy=timers.target
