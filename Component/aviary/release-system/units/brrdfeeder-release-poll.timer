[Unit]
Description=BRRDfeeder pull-only periodic package convergence

[Timer]
OnBootSec=2min
OnUnitInactiveSec=15min
RandomizedDelaySec=5min
AccuracySec=30s
Unit=brrdfeeder-release-poll.service

[Install]
WantedBy=timers.target
