[Unit]
Description=Recover interrupted BRRDfeeder package transaction (offline)
After=local-fs.target
Before=brrdfeeder-release-poll.service
ConditionPathExists=/etc/brrdfeeder/updater.json

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/brrdfeeder-release-launch recover
TimeoutStartSec=20min
UMask=0077

[Install]
WantedBy=multi-user.target
