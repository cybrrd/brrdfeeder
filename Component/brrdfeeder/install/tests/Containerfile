# Disposable fixtures only. Never an installed product or privileged host mount.
FROM docker.io/library/debian:13-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
# Freeze the transitive Debian package universe as well as direct tools.
RUN printf '%s\n' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260928T000000Z trixie main' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260928T000000Z trixie-security main' \
    > /etc/apt/sources.list && rm -f /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
      python3=3.13.5-1 python3-yaml=6.0.2-1+b2 jq=1.7.1-6+deb13u4 \
      chrony=4.6.1-3+deb13u2 usbutils=1:018-2 uidmap=1:4.17.4-2 \
      dbus-user-session=1.16.2-2 fuse-overlayfs=1.14-1+b1 sudo=1.9.16p2-3+deb13u2 \
    && rm -rf /var/lib/apt/lists/*
